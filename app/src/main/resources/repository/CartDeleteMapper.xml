<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sotugyouseisaku.app.repository.cart.CartDeleteMapper">

    <!-- 単一の cartId を指定して削除 -->
    <delete id="deleteCartItem" parameterType="int">
        DELETE FROM online_shop.cart
        WHERE id = #{cartId}
    </delete>

    <!-- 削除対象を確認したいとき用（必要なら） -->
    <!--
    <select id="selectAllCartForDelete" resultType="com.sotugyouseisaku.app.Record.CartDeleteRecord">
        SELECT id AS cartId,
               product_id AS productId,
               quantity,
               added_at AS addedAt
        FROM online_shop.cart
    </select>
    -->

</mapper>
